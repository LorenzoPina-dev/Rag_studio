# Application
APP_NAME=RAG Studio API
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Obbligatorio prima di esporre la API in rete: i metodi mutanti richiedono X-API-Token
API_ACCESS_TOKEN=

# Database / persistence
PERSISTENCE_BACKEND=memory
DATABASE_URL=postgresql+psycopg://ragstudio:ragstudio@localhost:5432/ragstudio
DB_ECHO=false
DB_POOL_PRE_PING=true

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Artifact content storage (memory | filesystem | minio)
ARTIFACT_STORE_BACKEND=memory
ARTIFACT_ROOT_DIR=./.artifacts
ARTIFACT_RETENTION_DAYS=30
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=ragstudio
S3_SECRET_KEY=ragstudio-secret
S3_BUCKET_ARTIFACTS=ragstudio-artifacts
S3_REGION=us-east-1
S3_SECURE=false

# Local dataset connectors: root del repository + cartella temp di default.
# Override: elenco separato da virgole o array JSON di percorsi assoluti.
DATASET_ALLOWED_ROOTS=
# False = blocca IP privati/loopback/link-local nei connettori HTTP.
ALLOW_PRIVATE_CONNECTORS=false

# Provider reali (pl_real_rag). NON inserire chiavi reali in questo file.
OPENAI_API_KEY=
OPENAI_BASE_URL=
HF_EMBEDDING_MODEL=
HF_RERANKER_MODEL=
HF_GENERATOR_MODEL=
OLLAMA_BASE_URL=

# Security / secrets (replace in production)
SECRET_KEY=change-me-in-production
ENCRYPTION_KEY=change-me-32-byte-key-base64-or-fernet
# Chiave Fernet (32 byte base64 url-safe, es. generata con Fernet.generate_key())
# per cifrare provider_settings.json. NON committare la chiave: tenerla solo in .env
# locale / secret manager. Se vuota le credenziali restano in chiaro (solo sviluppo).
PROVIDER_SETTINGS_KEY=

# Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=rag-studio-backend
OTEL_EXPORTER_OTLP_ENDPOINT=

# Execution runtime
EXECUTION_DEFAULT_TIMEOUT_SECONDS=600
EXECUTION_NODE_TIMEOUT_SECONDS=300
EXECUTION_RETRY_MAX_ATTEMPTS=1
EXECUTION_RETRY_BACKOFF_SECONDS=0
EXECUTION_MAX_PARALLEL_NODES=4
EXECUTION_MAX_PARALLEL_EXECUTIONS=2
EXECUTION_SLOT_TTL_SECONDS=600
CUSTOM_NODE_RUNTIME=isolated-worker

# Coordination (use redis with multiple API workers)
STREAM_COORDINATION_BACKEND=memory
STREAM_LOCK_TTL_SECONDS=600
STREAM_WAIT_TIMEOUT_SECONDS=30
